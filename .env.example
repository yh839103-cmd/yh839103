# LINE Developers Console → Messaging API
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# Google AI Studio → Get API key（免費）
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite

# Tavily 搜尋 API → https://tavily.com（每月 1,000 次免費、不用信用卡）
TAVILY_API_KEY=

# 選填
# SYSTEM_PROMPT=你是一個友善的助理
MAX_TURNS=10
SESSION_TTL=3600
PORT=8000
